{
  "name": "@spexr/desktop",
  "version": "0.1.5",
  "private": true,
  "description": "SPEXR desktop shell — Theia + Electron",
  "homepage": "https://github.com/sondalab-ai/spexr-ide",
  "author": {
    "name": "SPEXR",
    "email": "marcello.barile@gmail.com"
  },
  "license": "MIT",
  "main": "src-gen/backend/electron-main.js",
  "scripts": {
    "build": "theia build --mode=production",
    "build:dev": "theia build --mode=development",
    "rebuild": "theia rebuild:electron --cacheRoot ../../",
    "start": "electron src-gen/backend/electron-main.js",
    "dev": "theia build --mode=development --watch",
    "lint": "echo \"no source files\"",
    "typecheck": "echo \"no source files\"",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf src-gen lib gen-webpack*.js .turbo *.tsbuildinfo dist-installers",
    "package": "electron-builder --config electron-builder.yml",
    "package:mac": "electron-builder --mac --config electron-builder.yml",
    "package:win": "electron-builder --win --config electron-builder.yml",
    "package:linux": "electron-builder --linux --config electron-builder.yml"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "SPEXR",
        "electron": {
          "windowOptions": {
            "width": 1280,
            "height": 800,
            "minWidth": 1024,
            "minHeight": 640,
            "backgroundColor": "#070A0D"
          }
        },
        "preferences": {
          "files.enableTrash": true,
          "editor.fontFamily": "'JetBrains Mono', 'Geist Mono', 'SF Mono', monospace",
          "editor.wordWrap": "on",
          "editor.cursorStyle": "block",
          "workspace.preserveWindow": true
        }
      }
    },
    "backend": {
      "config": {
        "startupTimeout": -1
      }
    },
    "generator": {
      "config": {
        "preloadTemplate": "preload.html"
      }
    }
  },
  "dependencies": {
    "@spexr/theia-extensions": "workspace:*",
    "electron-updater": "^6.3.9",
    "@theia/core": "^1.75.0",
    "@theia/editor": "^1.75.0",
    "@theia/electron": "^1.75.0",
    "@theia/file-search": "^1.75.0",
    "@theia/filesystem": "^1.75.0",
    "@theia/scm": "1.75.0",
    "@theia/markers": "^1.75.0",
    "@theia/messages": "^1.75.0",
    "@theia/monaco": "^1.75.0",
    "@theia/monaco-editor-core": "1.108.201",
    "@theia/navigator": "^1.75.0",
    "@theia/outline-view": "^1.75.0",
    "@theia/preferences": "^1.75.0",
    "@theia/process": "^1.75.0",
    "@theia/terminal": "^1.75.0",
    "@theia/userstorage": "^1.75.0",
    "@theia/variable-resolver": "^1.75.0",
    "@theia/workspace": "^1.75.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@theia/cli": "^1.75.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^42.8.1",
    "electron-builder": "^25.1.8",
    "typescript": "^6.0.3"
  }
}
